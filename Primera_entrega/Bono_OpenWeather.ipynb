import requests
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns

# 1. Configuración
# Nota: Asegúrate de que la API Key ya esté activa (puede tardar 2 horas desde su creación)
api_key = "97e206527c2b35c4d3a7ea3217737ed9"
ciudades = ["Quibdo", "Riohacha", "Buenaventura", "Bogota"]
datos_clima = []

print("--- INICIANDO CONSULTA CLIMÁTICA ---")

# 2. Extracción con validación de respuesta
for ciudad in ciudades:
    url = f"http://api.openweathermap.org/data/2.5/weather?q={ciudad},CO&appid={api_key}&units=metric"
    respuesta = requests.get(url)
    datos = respuesta.json()

    # Verificamos si la respuesta fue exitosa (Código 200)
    if respuesta.status_code == 200:
        temp = datos['main']['temp']
        humedad = datos['main']['humidity']
        datos_clima.append({"Ciudad": ciudad, "Temperatura (°C)": temp, "Humedad (%)": humedad})
        print(f" {ciudad}: Datos recibidos.")
    else:
        # Si falla, imprimimos el error real de la API
        print(f"{ciudad}: Error {respuesta.status_code} - {datos.get('message', 'Error desconocido')}")

# 3. Procesamiento
if datos_clima:
    df_clima = pd.DataFrame(datos_clima)
    
    # 4. Visualización
    plt.figure(figsize=(10, 6))
    sns.set_style("whitegrid")
    
    # Gráfico de barras para Temperatura
    grafica = sns.barplot(data=df_clima, x='Ciudad', y='Temperatura (°C)', palette='coolwarm')
    
    plt.title('Comparativa Climática: Extremos de Colombia', fontsize=15, fontweight='bold')
    plt.ylabel('Grados Celsius (°C)')
    plt.xlabel('Ciudad')
    
    # Etiquetas de valor sobre las barras
    for p in grafica.patches:
        grafica.annotate(f'{p.get_height()}°C', 
                         (p.get_x() + p.get_width() / 2., p.get_height()), 
                         ha='center', va='center', xytext=(0, 9), 
                         textcoords='offset points', fontweight='bold')
    
    plt.tight_layout()
    plt.show()
    
    # Opcional: Mostrar también la humedad para aprovechar los datos de Quibdó
    print("\nTabla comparativa final:")
    print(df_clima.to_string(index=False))
    
    print("\n--- PROCESO FINALIZADO CON ÉXITO ---")
else:
    print("\nNo se pudo generar el gráfico")